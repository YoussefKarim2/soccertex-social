# Copy to .env and fill in. Never commit .env — it is gitignored.

# ── Instagram ── Instagram API with Unified Login (SETUP.md step 2).
# Standard Access is enough to publish to an account that holds a role on the
# app, so no App Review. The old Instagram-Login route (graph.instagram.com,
# instagram_business_* scopes) is closed to apps created from 2026 on.
#
# IG_ACCESS_TOKEN is a Business Integration System User Access Token, generated
# in the App Dashboard under Instagram API > API setup with Unified login.
# It is NOT refreshed on a timer; token-health.yml just checks it still works.
# IG_USER_ID is optional — discovered via /me/assigned_instagram_accounts, and
# only needed if more than one Instagram account is shared with the app.
IG_USER_ID=
IG_ACCESS_TOKEN=

# ── LinkedIn ── posts to your PERSONAL profile via the self-serve
# "Share on LinkedIn" product (w_member_social). No review needed.
# LI_AUTHOR_URN is optional — it is fetched from /v2/userinfo if blank.
LI_ACCESS_TOKEN=
LI_AUTHOR_URN=

# Your GitHub Pages URL, no trailing slash. Both platforms fetch media from here.
MEDIA_BASE_URL=
